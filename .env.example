# Copy to .env and fill in. .env is read automatically by llm_agent.py and is
# git-ignored, so the real key never gets committed.
#
# On Streamlit Community Cloud, do not deploy a .env at all. Put these same
# keys in the app's Settings -> Secrets panel instead (TOML format, same names);
# app.py reads st.secrets first and falls back to the environment.

# --- Uncomment the line for your provider and paste your key ---
# Leave the other one commented out: a placeholder value counts as a key.
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# --- Optional overrides ---
# Which provider the app defaults to: anthropic | openai
# (unset: whichever provider has a key, Anthropic if both do)
# ANALYSEIT_LLM_PROVIDER=anthropic
# Override the default model (claude-haiku-4-5 / gpt-4o-mini)
# ANALYSEIT_LLM_MODEL=claude-haiku-4-5

# Embedding backend: sentence-transformers (local dev) | onnx (slim deploy).
# Leave unset to auto-detect: sentence-transformers if installed, else onnx.
# ANALYSEIT_EMBED_BACKEND=onnx
